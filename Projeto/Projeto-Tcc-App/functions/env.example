# Exemplo de variáveis de ambiente para o backend do GamersLayer

# Configuração do Firebase
FIREBASE_API_KEY=SEU_API_KEY_AQUI
FIREBASE_AUTH_DOMAIN=SEU_AUTH_DOMAIN_AQUI
FIREBASE_PROJECT_ID=SEU_PROJECT_ID_AQUI
FIREBASE_STORAGE_BUCKET=SEU_STORAGE_BUCKET_AQUI
FIREBASE_MESSAGING_SENDER_ID=SEU_MESSAGING_SENDER_ID_AQUI
FIREBASE_APP_ID=SEU_APP_ID_AQUI
FIREBASE_MEASUREMENT_ID=SEU_MEASUREMENT_ID_AQUI

# Configuração do Play Store API
PLAY_STORE_API_KEY=SEU_PLAY_STORE_API_KEY_AQUI

# Configuração do RAWG API
RAWG_API_KEY=SEU_RAWG_API_KEY_AQUI

# Configuração do Banco de Dados
DATABASE_URL=SEU_DATABASE_URL_AQUI

# Configuração de Segurança
JWT_SECRET=SEU_JWT_SECRET_AQUI

# Configuração do Email
SMTP_HOST=SEU_SMTP_HOST_AQUI
SMTP_PORT=SEU_SMTP_PORT_AQUI
SMTP_USER=SEU_SMTP_USER_AQUI
SMTP_PASS=SEU_SMTP_PASS_AQUI

# Configuração do Storage
STORAGE_BUCKET=SEU_STORAGE_BUCKET_AQUI

# Configuração de Logs
LOG_LEVEL=debug

# Configuração de Cache
CACHE_PROVIDER=redis
CACHE_TTL=3600

# Configuração de Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Configuração de Autenticação
AUTH_SECRET=SEU_AUTH_SECRET_AQUI
AUTH_EXPIRES_IN=7d

# Configuração de Segurança Adicional
CORS_ORIGIN=*
ALLOWED_ORIGINS=*

# Configuração de Performance
MAX_CONNECTIONS=100
TIMEOUT=30000

# Configuração de Debug
DEBUG_MODE=false

# NOTE: Este é apenas um exemplo. Crie seu próprio arquivo .env com os valores reais
# e mantenha-o fora do controle de versão (gitignore).
